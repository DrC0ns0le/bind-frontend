# Example Environment Variables
# Copy this file to .env.development for local development
# Copy this file to .env.production for production builds

# API URL - Backend server endpoint
VITE_API_URL=http://localhost:8080/

# Auth Bypass (Development Only)
# Set to 'true' to bypass authentication during development
# WARNING: Never set this to 'true' in production!
# VITE_AUTH_BYPASS=true

# OAuth2 Configuration (if using OAuth2)
# VITE_OAUTH_CLIENT_ID=your-client-id
# VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_OAUTH_AUTHORIZE_URL=https://your-oauth-provider.com/oauth/authorize
